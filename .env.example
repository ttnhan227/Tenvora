# ==============================================================================
# TENVORA UNIFIED ROOT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust credentials as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=tenvora_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
# Local dotnet runs use localhost with SSL disabled for dev. Compose and production use encrypted connections.
DATABASE_URL=Host=localhost;Port=5432;Database=tenvora_db;Username=postgres;Password=your_secure_postgres_password_here;SSL Mode=Require;Trust Server Certificate=false

# ------------------------------------------------------------------------------
# 2. BACKEND API & SECURITY (.NET Core)
# ------------------------------------------------------------------------------
PORT=5000
ENABLE_SWAGGER=true
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_12345
JwtSettings__Issuer=Tenvora
JwtSettings__Audience=Tenvora
CLIENT_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000,http://client
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ------------------------------------------------------------------------------
# 3. AI AGENT & ASSISTANT (Google Gemini)
# ------------------------------------------------------------------------------
AI_PROVIDER_NAME=Google Gemini
AI_PROVIDER_API_KEY=your_gemini_api_key_here
AI_PROVIDER_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
AI_CHAT_MODEL=gemini-3.5-flash-lite

# Mistral AI (fallback provider if Gemini quota is exhausted)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=ministral-8b-latest

# ------------------------------------------------------------------------------
# 4. FRONTEND CLIENT (Vite / React)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
# Set only after the public Google Play listing is live.
VITE_GOOGLE_PLAY_URL=
VITE_SUPPORT_EMAIL=ccleemon227@gmail.com

# ------------------------------------------------------------------------------
# 5. DATABASE SEED CREDENTIALS (Private initial seed credentials)
# ------------------------------------------------------------------------------
SEED_DEMO_DATA=false
SEED_TENANT_NAME=Example Business
SEED_TENANT_API_KEY=your_tenant_api_key_here
SEED_ADMIN_EMAIL=owner@tenvora.internal
SEED_ADMIN_PASSWORD=your_initial_admin_password_here
