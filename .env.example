# ==============================================================================
# TENVORA UNIFIED ROOT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and adjust credentials as needed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=tenvora_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
DATABASE_URL=Host=postgres;Port=5432;Database=tenvora_db;Username=postgres;Password=your_secure_postgres_password_here;SSL Mode=Disable;Trust Server Certificate=true
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=tenvora_db;Username=postgres;Password=your_secure_postgres_password_here;SSL Mode=Disable;Trust Server Certificate=true

# ------------------------------------------------------------------------------
# 2. BACKEND API & SECURITY (.NET Core)
# ------------------------------------------------------------------------------
PORT=5000
ENABLE_SWAGGER=true
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_12345
JwtSettings__Secret=your_jwt_secret_key_at_least_32_characters_long_12345
JwtSettings__Issuer=Tenvora
JwtSettings__Audience=Tenvora
CLIENT_ORIGINS=http://localhost:5173,http://localhost:80,http://localhost:3000,http://client

# ------------------------------------------------------------------------------
# 3. LIVE MARKET INTELLIGENCE & RSS FEEDS (Optional)
# ------------------------------------------------------------------------------
FINLIGHT_API_KEY=
NEWSAPIAI_API_KEY=
GNEWS_API_KEY=

# ------------------------------------------------------------------------------
# 4. AI COPILOT & LLM SETTINGS (Optional)
# ------------------------------------------------------------------------------
AI_PROVIDER_NAME=Mistral
AI_PROVIDER_API_KEY=
AI_PROVIDER_ENDPOINT=https://api.mistral.ai/v1/chat/completions
AI_CHAT_MODEL=mistral-small-latest
AI_VISION_MODEL=mistral-small-latest

# ------------------------------------------------------------------------------
# 5. FRONTEND CLIENT (Vite / React)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_URL=http://localhost:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 6. DATABASE SEED CREDENTIALS (Private initial seed credentials)
# ------------------------------------------------------------------------------
SEED_TENANT_NAME=Global FinOps Corp
SEED_TENANT_API_KEY=tenvora-live-api-key-global-finops-001
SEED_ADMIN_EMAIL=admin@tenvora.internal
SEED_ADMIN_PASSWORD=your_initial_admin_password_here
SEED_OPS_EMAIL=ops.manager@tenvora.internal
SEED_OPS_PASSWORD=your_initial_ops_password_here
SEED_COMPLIANCE_EMAIL=compliance@tenvora.internal
SEED_COMPLIANCE_PASSWORD=your_initial_compliance_password_here
