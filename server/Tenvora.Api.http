@server_HostAddress = http://localhost:5000

### Health
GET {{server_HostAddress}}/api/health/ready
Accept: application/json

### Sign in
# @name login
POST {{server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "owner@tenvora.internal",
  "password": "AdminPass123!"
}

@authToken = {{login.response.body.data.accessToken}}

### Dashboard
GET {{server_HostAddress}}/api/business-dashboard
Authorization: Bearer {{authToken}}

### Customers
GET {{server_HostAddress}}/api/customers
Authorization: Bearer {{authToken}}

### Products
GET {{server_HostAddress}}/api/products
Authorization: Bearer {{authToken}}

### Sales
GET {{server_HostAddress}}/api/sales
Authorization: Bearer {{authToken}}

### Suppliers and purchases
GET {{server_HostAddress}}/api/suppliers
Authorization: Bearer {{authToken}}

GET {{server_HostAddress}}/api/purchases
Authorization: Bearer {{authToken}}

### Expenses
GET {{server_HostAddress}}/api/business-expenses
Authorization: Bearer {{authToken}}
